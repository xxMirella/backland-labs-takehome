# Single env file for the whole repo (copied to .env by `npm run setup`).
# SQLite path is relative to packages/db/prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# AI analysis via OpenRouter. Get a key at https://openrouter.ai/keys
# Without a key, intakes are still saved but not analysed.
OPENROUTER_API_KEY=""
# Optional: model slug from https://openrouter.ai/models (default: openrouter/free)
# OPENROUTER_MODEL=""

# Comma-separated emails of team members who can see every intake (others only see their own)
ADMIN_EMAILS=""
