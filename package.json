{
  "name": "project-intake",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "predev": "node scripts/setup.mjs --quiet",
    "dev": "npm run dev -w @app/web",
    "build": "npm run build -w @app/web",
    "start": "npm run start -w @app/web",
    "db:generate": "npm run generate -w @app/db",
    "db:migrate": "npm run migrate -w @app/db",
    "db:deploy": "npm run deploy -w @app/db",
    "db:reset": "npm run reset -w @app/db",
    "db:studio": "npm run studio -w @app/db",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "jsdom": "^30.1.3",
    "vitest": "^3.2.7"
  }
}
